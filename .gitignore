# Run logs -- local noise, and they churn every month.
refresh.log
launchd.out.log
launchd.err.log

# Transient files from the atomic write / log rotation.
.usmnt-all-levels.ics.*
.refresh.log.*

# Last good response from each source, rewritten on every live run. Distinct
# from fixtures/, which is the frozen corpus the tests assert against and must
# never be touched by a run.
cache/

.DS_Store
__pycache__/
*.pyc

# NOTE: usmnt-all-levels.ics is deliberately NOT ignored. It is the published
# artifact -- the raw GitHub URL your calendar subscribes to serves it straight
# out of this repo, so it has to be committed.
#
# fixtures/ is also deliberately tracked: the tests run against those saved
# responses, and --offline rebuilds from them.
